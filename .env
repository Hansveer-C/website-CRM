# Backend-only credentials (not exposed to Vite)
# These MUST NOT start with VITE_ to prevent accidental bundle leaks.
TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# JWT Secret (Move to backend-only context)
JWT_SECRET=antigravity_safe_default_secret_123
