# Browser runtime. Production must use Supabase and never enables browser fixtures.
VITE_BUILDER_PUBLICATION_PERSISTENCE=supabase
VITE_BUILDER_MEDIA_PERSISTENCE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Local-only, explicit fixture adapter. Ignored when import.meta.env.PROD is true.
VITE_ENABLE_BROWSER_FIXTURES=false
VITE_BROWSER_FIXTURE_ZERO_WEBSITE=false

# Vercel Function server environment (never prefix secrets with VITE_).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
