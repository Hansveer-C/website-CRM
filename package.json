    "supabase:local:reset": "npm run supabase:local:guard && npx --yes supabase@2.116.0 db reset --local --no-seed",
    "supabase:local:test": "node supabase/tests/local_supabase_integration.mjs",
    "test:doc-1b2:live": "tsx supabase/tests/doc_1b2_live_integration.ts",
    "supabase:local:stop": "npx --yes supabase@2.116.0 stop"
  },
