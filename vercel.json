{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/not-found"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
