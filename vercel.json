{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/c04-property-domain": false,
      "codex/password-recovery": false
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api(?:/.*)?", "dest": "/api/not-found" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
